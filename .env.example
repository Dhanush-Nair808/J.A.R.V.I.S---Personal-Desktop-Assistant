# Copy this file to .env and replace values before running the app.
# Backend service settings
GOOGLE_API_KEY=
MISTRAL_API_KEY=
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Model and voice settings
GEMINI_MODEL=models/gemini-2.0-flash-lite-001
MISTRAL_MODEL=mistral-large-2407
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_VOICE=en-US-GuyNeural
SAFE_ROOT=workspace

# Optional SMTP/email settings
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
